---
// Todo lo que escribas entre estas tres rayas se ejecuta en el servidor. 
// Por ahora lo dejaremos vacío.
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
}

const { title = 'Laboratorio Mendieta' } = Astro.props;
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/images/Logotipo.png" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <!-- Astro buscará automáticamente este archivo en la carpeta public/ -->
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <Navbar />
    <!-- El componente <slot /> es la magia de Astro. 
         Aquí se inyectará automáticamente el contenido de cada página -->
    <slot />
    <Footer />
    <script is:inline src="/app.js"></script>
  </body>
</html>